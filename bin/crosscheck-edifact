#!/usr/bin/env ruby
# Cross-checks the YAML SSOT against the UN/EDIFACT D.05B directory
# (independent electronic typesetting of the same element base).
# Corpus: sources/edifact-D05B/segments.xml — a mirror of the official
# UNECE publication (unece.org/trade/uncefact/unedifact/download), which
# lists every data element used in segments with name, description, type
# and max length. Mismatches on matched tags are strong signals; tags
# absent from the mirror are informational (the mirror only covers
# elements referenced by segments).
$LOAD_PATH.unshift File.expand_path("../model", __dir__)
ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)
require "bundler/setup"
require "untded"
require "rexml/document"

data_dir = File.expand_path("../data", __dir__)
xml_path = File.expand_path("../../references/edifact-D05B/segments.xml", __dir__)

mirror = Untded::EdifactJoin.mirror(xml_path).transform_values do |m|
  { name: m.name, desc: m.desc, type: m.type, max: m.max_length }
end

ours = Dir.glob(File.join(data_dir, "elements", "*.yaml")).sort.flat_map do |path|
  Untded::ElementFile.from_yaml(File.read(path)).elements
end
active = ours.select { |e| e.status == "active" }
matched = active.select { |e| mirror.key?(e.tag) }

def norm_name(s)
  s.downcase.gsub(/[^a-z0-9]/, "")
end

def norm_desc(s)
  s.downcase.gsub(/[^a-z0-9 ]/, "").gsub(/\s+/, " ").strip
end

def lev(a, b)
  prev = (0..b.length).to_a
  a.each_char.with_index do |ca, i|
    cur = [i + 1]
    b.each_char.with_index do |cb, j|
      cur << [prev[j + 1] + 1, cur[j] + 1, prev[j] + (ca == cb ? 0 : 1)].min
    end
    prev = cur
  end
  prev.last
end

def desc_sim(a, b)
  return 1.0 if a == b
  1.0 - lev(a, b).to_f / [a.length, b.length].max
end

repr_match = repr_diff = 0
repr_examples = []
name_match = 0
desc_match = desc_diff = 0
desc_examples = []

matched.each do |e|
  m = mirror[e.tag]
  if e.representation
    ours_max = e.representation.max_length
    ours_cs = e.representation.charset
    if ours_cs == m[:type] && ours_max == m[:max]
      repr_match += 1
    else
      repr_diff += 1
      repr_examples << "#{e.tag}: ours #{e.representation.raw} vs D05B #{m[:type]}..#{m[:max]}"
    end
  end
  name_match += 1 if e.name && norm_name(e.name) == norm_name(m[:name])
  if e.description
    if desc_sim(norm_desc(e.description), norm_desc(m[:desc])) >= 0.85
      desc_match += 1
    else
      desc_diff += 1
      desc_examples << "#{e.tag}:\n    ours: #{e.description[0, 100]}\n    D05B: #{m[:desc][0, 100]}"
    end
  end
end

only_ours = active.map(&:tag).reject { |t| mirror.key?(t) }
only_mirror = mirror.keys.reject { |t| active.any? { |e| e.tag == t } }.sort

puts "UNTDED 2005 active elements: #{active.size}"
puts "D05B elements (>=1000) in mirror: #{mirror.size}"
puts "joined on tag: #{matched.size}"
puts
puts "representation: #{repr_match}/#{repr_match + repr_diff} agree on charset+max length"
repr_examples.first(15).each { |x| puts "  DIFF #{x}" }
puts
puts "name (normalized, conventions differ): #{name_match}/#{matched.size} identical"
puts
puts "description: #{desc_match}/#{desc_match + desc_diff} similar (>=0.85)"
desc_examples.first(8).each { |x| puts "  DIFF #{x}" }
puts
puts "tags only in UNTDED (not used in D05B segments): #{only_ours.size}"
puts "tags only in D05B mirror (not active in UNTDED): #{only_mirror.size} #{only_mirror.first(20).inspect}"

report = StringIO.new
report.puts "UN/EDIFACT D.05B cross-check, generated by bin/crosscheck-edifact"
report.puts "mirror: php-edifact/edifact-data D05B/segments.xml (mirror of UNECE publication)"
report.puts({ joined: matched.size, repr_match: repr_match, repr_diff: repr_diff,
              name_match: name_match, desc_match: desc_match, desc_diff: desc_diff,
              only_ours: only_ours.size, only_mirror: only_mirror }.inspect)
report.puts "\nREPR DIFFS:\n" + repr_examples.join("\n")
report.puts "\nDESC DIFFS:\n" + desc_examples.join("\n")
File.write(File.expand_path("../../references/edifact-D05B/crosscheck-report.txt", __dir__), report.string)
puts "\nfull report: references/edifact-D05B/crosscheck-report.txt"
